@page "/text-compare"

<PageTitle>Text Compare - James McNeil</PageTitle>

<section class="experiment-page">
    <div class="section-container">
        <div class="section-header">
            <h1>Text Compare</h1>
            <p>Paste two pieces of text below and compare them to see the differences highlighted</p>
        </div>

        <div class="compare-inputs">
            <div class="compare-input-col">
                <label class="compare-label">Original Text</label>
                <textarea class="compare-textarea" @bind="textA" placeholder="Paste original text here..."></textarea>
            </div>
            <div class="compare-input-col">
                <label class="compare-label">Modified Text</label>
                <textarea class="compare-textarea" @bind="textB" placeholder="Paste modified text here..."></textarea>
            </div>
        </div>

        <div class="compare-actions">
            <button class="btn btn-primary" @onclick="RunCompare">Compare</button>
            <button class="btn btn-secondary" @onclick="ClearAll">Clear</button>
            @if (diffResult != null)
            {
                <span class="compare-stats">
                    <span class="stat-added">+@addedCount added</span>
                    <span class="stat-removed">-@removedCount removed</span>
                    <span class="stat-unchanged">@unchangedCount unchanged</span>
                </span>
            }
        </div>

        @if (diffResult != null)
        {
            <div class="compare-output">
                <div class="compare-output-header">
                    <span>Diff Result</span>
                    <div class="compare-legend">
                        <span class="legend-item"><span class="legend-color legend-added"></span> Added</span>
                        <span class="legend-item"><span class="legend-color legend-removed"></span> Removed</span>
                    </div>
                </div>
                <div class="compare-diff">
                    @foreach (var line in diffResult)
                    {
                        <div class="diff-line @line.CssClass">
                            <span class="diff-marker">@line.Marker</span>
                            <span class="diff-text">@line.Text</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private string textA = "";
    private string textB = "";
    private List<DiffLine>? diffResult;
    private int addedCount;
    private int removedCount;
    private int unchangedCount;

    private class DiffLine
    {
        public string Text { get; set; } = "";
        public string CssClass { get; set; } = "";
        public string Marker { get; set; } = " ";
    }

    private void ClearAll()
    {
        textA = "";
        textB = "";
        diffResult = null;
    }

    private void RunCompare()
    {
        var linesA = (textA ?? "").Split('\n');
        var linesB = (textB ?? "").Split('\n');

        var diff = ComputeDiff(linesA, linesB);
        diffResult = diff;

        addedCount = diff.Count(d => d.CssClass == "diff-added");
        removedCount = diff.Count(d => d.CssClass == "diff-removed");
        unchangedCount = diff.Count(d => d.CssClass == "diff-unchanged");
    }

    // Myers-like LCS diff algorithm
    private static List<DiffLine> ComputeDiff(string[] a, string[] b)
    {
        int n = a.Length;
        int m = b.Length;

        // Compute LCS table
        int[,] dp = new int[n + 1, m + 1];
        for (int i = 1; i <= n; i++)
        {
            for (int j = 1; j <= m; j++)
            {
                if (a[i - 1].TrimEnd('\r') == b[j - 1].TrimEnd('\r'))
                    dp[i, j] = dp[i - 1, j - 1] + 1;
                else
                    dp[i, j] = Math.Max(dp[i - 1, j], dp[i, j - 1]);
            }
        }

        // Backtrack to produce diff
        var result = new List<DiffLine>();
        int ii = n, jj = m;
        var stack = new Stack<DiffLine>();

        while (ii > 0 || jj > 0)
        {
            if (ii > 0 && jj > 0 && a[ii - 1].TrimEnd('\r') == b[jj - 1].TrimEnd('\r'))
            {
                stack.Push(new DiffLine { Text = a[ii - 1].TrimEnd('\r'), CssClass = "diff-unchanged", Marker = " " });
                ii--;
                jj--;
            }
            else if (jj > 0 && (ii == 0 || dp[ii, jj - 1] >= dp[ii - 1, jj]))
            {
                stack.Push(new DiffLine { Text = b[jj - 1].TrimEnd('\r'), CssClass = "diff-added", Marker = "+" });
                jj--;
            }
            else
            {
                stack.Push(new DiffLine { Text = a[ii - 1].TrimEnd('\r'), CssClass = "diff-removed", Marker = "−" });
                ii--;
            }
        }

        while (stack.Count > 0)
            result.Add(stack.Pop());

        return result;
    }
}
