@implements IDisposable

@if (!gameStarted)
{
    <div class="game-start-screen">
        <div class="game-title-icon">🐦</div>
        <h2>Flappy Bird</h2>
        <p>Press Space or click/tap to flap. Avoid the pipes and see how far you can go!</p>
        <button class="btn btn-primary" @onclick="StartGame">Start Game</button>
    </div>
}
else if (gameOver)
{
    <div class="game-start-screen">
        <div class="game-title-icon">💥</div>
        <h2>Game Over!</h2>
        <p>You scored <strong>@score</strong> points!</p>
        <button class="btn btn-primary" @onclick="StartGame">Play Again</button>
    </div>
}
else
{
    <div class="game-hud">
        <div class="hud-item">
            <span class="hud-label">Score</span>
            <span class="hud-value">@score</span>
        </div>
    </div>

    <div class="flappy-field" @ref="flappyFieldRef" tabindex="0" @onkeydown="HandleKeyDown" @onkeydown:preventDefault @onclick="Flap">
        @for (int r = 0; r < Rows; r++)
        {
            var row = r;
            @for (int c = 0; c < Cols; c++)
            {
                var col = c;
                var cellType = GetCellType(row, col);
                <div class="flappy-cell @cellType"></div>
            }
        }
    </div>

    <div class="mobile-controls">
        <div class="controls-row">
            <button class="control-btn flap-btn" @onclick="Flap">FLAP ▲</button>
        </div>
    </div>
}

@code {
    private const int Rows = 20;
    private const int Cols = 15;
    private const int BirdCol = 3;
    private const int GapSize = 5;

    private ElementReference flappyFieldRef;
    private int birdRow;
    private int gravityCounter;
    private int flapCounter;
    private bool isFlapping;
    private List<PipeData> pipes = new();
    private int score;
    private bool gameStarted;
    private bool gameOver;
    private System.Threading.Timer? gameTimer;
    private Random rng = new();
    private int frameCount;

    private class PipeData
    {
        public int Col { get; set; }
        public int GapTop { get; set; }
        public bool Passed { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (gameStarted && !gameOver)
        {
            try { await flappyFieldRef.FocusAsync(); } catch { }
        }
    }

    private string GetCellType(int row, int col)
    {
        if (row == birdRow && col == BirdCol)
            return "flappy-bird-cell";

        foreach (var pipe in pipes)
        {
            if (col == pipe.Col || col == pipe.Col + 1)
            {
                bool inGap = row >= pipe.GapTop && row < pipe.GapTop + GapSize;
                if (!inGap)
                    return "flappy-pipe-cell";
                else
                    return "flappy-gap-cell";
            }
        }

        if (row >= Rows - 2)
            return "flappy-ground-cell";

        return "flappy-sky-cell";
    }

    private void StartGame()
    {
        birdRow = Rows / 2;
        gravityCounter = 0;
        flapCounter = 0;
        isFlapping = false;
        pipes.Clear();
        score = 0;
        frameCount = 0;
        gameStarted = true;
        gameOver = false;

        gameTimer = new System.Threading.Timer(GameLoop, null, 0, 100);
    }

    private void GameLoop(object? state)
    {
        if (gameOver) return;

        frameCount++;

        // Handle flap (move up)
        if (isFlapping && flapCounter < 3)
        {
            flapCounter++;
            birdRow--;
        }
        else
        {
            isFlapping = false;
            flapCounter = 0;

            // Gravity: bird falls 1 cell every 3 frames
            gravityCounter++;
            if (gravityCounter >= 3)
            {
                gravityCounter = 0;
                birdRow++;
            }
        }

        // Move pipes left every 2 frames
        if (frameCount % 2 == 0)
        {
            foreach (var pipe in pipes)
            {
                pipe.Col--;

                if (!pipe.Passed && pipe.Col + 1 < BirdCol)
                {
                    pipe.Passed = true;
                    score++;
                }
            }

            pipes.RemoveAll(p => p.Col < -1);
        }

        // Spawn new pipe every 14 frames
        if (frameCount % 14 == 0)
        {
            int gapTop = rng.Next(2, Rows - GapSize - 3);
            pipes.Add(new PipeData { Col = Cols - 1, GapTop = gapTop });
        }

        // Bounds check
        if (birdRow < 0 || birdRow >= Rows - 1)
        {
            EndGame();
            return;
        }

        // Pipe collision
        foreach (var pipe in pipes)
        {
            if (BirdCol == pipe.Col || BirdCol == pipe.Col + 1)
            {
                bool inGap = birdRow >= pipe.GapTop && birdRow < pipe.GapTop + GapSize;
                if (!inGap)
                {
                    EndGame();
                    return;
                }
            }
        }

        InvokeAsync(StateHasChanged);
    }

    private void Flap()
    {
        if (!gameOver)
        {
            isFlapping = true;
            flapCounter = 0;
            gravityCounter = 0;
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == " " || e.Key == "ArrowUp" || e.Key == "w" || e.Key == "W")
        {
            Flap();
        }
    }

    private void EndGame()
    {
        gameOver = true;
        gameTimer?.Dispose();
        gameTimer = null;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        gameTimer?.Dispose();
    }
}
