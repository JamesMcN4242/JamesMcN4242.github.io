@page "/text-compare"
@using System.Text

@if (!Embedded)
{
    <PageTitle>Text Compare - James McNeil</PageTitle>
}

<section class="experiment-page @(Embedded ? "embedded" : "")">
    <div class="@(Embedded ? "" : "section-container")">
        @if (!Embedded)
        {
            <div class="section-header">
                <h1>Text Compare</h1>
                <p>Paste two pieces of text below and compare them to see the differences highlighted</p>
            </div>
        }

        <div class="compare-inputs">
            <div class="compare-input-col">
                <label class="compare-label">Original Text</label>
                <textarea class="compare-textarea" @bind="textA" placeholder="Paste original text here..."></textarea>
            </div>
            <div class="compare-input-col">
                <label class="compare-label">Modified Text</label>
                <textarea class="compare-textarea" @bind="textB" placeholder="Paste modified text here..."></textarea>
            </div>
        </div>

        <div class="compare-actions">
            <button class="btn btn-primary" @onclick="RunCompare">Compare</button>
            <button class="btn btn-secondary" @onclick="ClearAll">Clear</button>
            @if (diffLines != null)
            {
                <span class="compare-stats">
                    <span class="stat-added">+@addedCount added</span>
                    <span class="stat-removed">-@removedCount removed</span>
                    <span class="stat-unchanged">@unchangedCount unchanged</span>
                </span>
            }
        </div>

        @if (diffLines != null)
        {
            <div class="compare-output">
                <div class="compare-output-header">
                    <span>Diff Result</span>
                    <div class="compare-legend">
                        <span class="legend-item"><span class="legend-color legend-added"></span> Added</span>
                        <span class="legend-item"><span class="legend-color legend-removed"></span> Removed</span>
                        <span class="legend-item"><span class="legend-color legend-changed"></span> Changed</span>
                    </div>
                </div>
                <div class="compare-diff">
                    @foreach (var line in diffLines)
                    {
                        <div class="diff-line @line.CssClass">
                            <span class="diff-marker">@line.Marker</span>
                            <span class="diff-text">@((MarkupString)line.Html)</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    [Parameter] public bool Embedded { get; set; }

    private string textA = "";
    private string textB = "";
    private List<DiffDisplayLine>? diffLines;
    private int addedCount;
    private int removedCount;
    private int unchangedCount;

    private class DiffDisplayLine
    {
        public string Html { get; set; } = "";
        public string CssClass { get; set; } = "";
        public string Marker { get; set; } = " ";
    }

    private enum DiffType { Unchanged, Removed, Added }

    private class RawDiffLine
    {
        public string Text { get; set; } = "";
        public DiffType Type { get; set; }
    }

    private void ClearAll()
    {
        textA = "";
        textB = "";
        diffLines = null;
    }

    private void RunCompare()
    {
        var linesA = (textA ?? "").Split('\n');
        var linesB = (textB ?? "").Split('\n');

        var rawDiff = ComputeLineDiff(linesA, linesB);

        // Post-process: pair up consecutive remove+add as "changed" with word-level highlighting
        diffLines = new List<DiffDisplayLine>();
        int i = 0;
        while (i < rawDiff.Count)
        {
            if (rawDiff[i].Type == DiffType.Unchanged)
            {
                diffLines.Add(new DiffDisplayLine
                {
                    Html = Encode(rawDiff[i].Text),
                    CssClass = "diff-unchanged",
                    Marker = " "
                });
                i++;
            }
            else if (rawDiff[i].Type == DiffType.Removed)
            {
                // Collect consecutive removed lines
                var removedLines = new List<string>();
                while (i < rawDiff.Count && rawDiff[i].Type == DiffType.Removed)
                {
                    removedLines.Add(rawDiff[i].Text);
                    i++;
                }

                // Collect consecutive added lines
                var addedLines = new List<string>();
                while (i < rawDiff.Count && rawDiff[i].Type == DiffType.Added)
                {
                    addedLines.Add(rawDiff[i].Text);
                    i++;
                }

                // Pair them up for word-level diff
                int pairs = Math.Min(removedLines.Count, addedLines.Count);
                for (int p = 0; p < pairs; p++)
                {
                    var wordDiff = ComputeWordDiff(removedLines[p], addedLines[p]);
                    diffLines.Add(new DiffDisplayLine
                    {
                        Html = wordDiff.removedHtml,
                        CssClass = "diff-changed-removed",
                        Marker = "−"
                    });
                    diffLines.Add(new DiffDisplayLine
                    {
                        Html = wordDiff.addedHtml,
                        CssClass = "diff-changed-added",
                        Marker = "+"
                    });
                }

                // Remaining unpaired removed lines
                for (int p = pairs; p < removedLines.Count; p++)
                {
                    diffLines.Add(new DiffDisplayLine
                    {
                        Html = Encode(removedLines[p]),
                        CssClass = "diff-removed",
                        Marker = "−"
                    });
                }

                // Remaining unpaired added lines
                for (int p = pairs; p < addedLines.Count; p++)
                {
                    diffLines.Add(new DiffDisplayLine
                    {
                        Html = Encode(addedLines[p]),
                        CssClass = "diff-added",
                        Marker = "+"
                    });
                }
            }
            else // Added without preceding removal
            {
                diffLines.Add(new DiffDisplayLine
                {
                    Html = Encode(rawDiff[i].Text),
                    CssClass = "diff-added",
                    Marker = "+"
                });
                i++;
            }
        }

        addedCount = diffLines.Count(d => d.CssClass == "diff-added" || d.CssClass == "diff-changed-added");
        removedCount = diffLines.Count(d => d.CssClass == "diff-removed" || d.CssClass == "diff-changed-removed");
        unchangedCount = diffLines.Count(d => d.CssClass == "diff-unchanged");
    }

    private static (string removedHtml, string addedHtml) ComputeWordDiff(string lineA, string lineB)
    {
        var wordsA = TokenizeWords(lineA);
        var wordsB = TokenizeWords(lineB);

        var matchA = new bool[wordsA.Length];
        var matchB = new bool[wordsB.Length];

        // Use DP backtracking for proper alignment
        int n = wordsA.Length, m = wordsB.Length;
        int[,] dp = new int[n + 1, m + 1];
        for (int i = 1; i <= n; i++)
            for (int j = 1; j <= m; j++)
                dp[i, j] = wordsA[i - 1] == wordsB[j - 1]
                    ? dp[i - 1, j - 1] + 1
                    : Math.Max(dp[i - 1, j], dp[i, j - 1]);

        // Backtrack
        int ai = n, bi = m;
        while (ai > 0 && bi > 0)
        {
            if (wordsA[ai - 1] == wordsB[bi - 1])
            {
                matchA[ai - 1] = true;
                matchB[bi - 1] = true;
                ai--; bi--;
            }
            else if (dp[ai - 1, bi] >= dp[ai, bi - 1])
            {
                ai--;
            }
            else
            {
                bi--;
            }
        }

        // Build HTML
        var removedSb = new StringBuilder();
        for (int i = 0; i < wordsA.Length; i++)
        {
            if (matchA[i])
                removedSb.Append(Encode(wordsA[i]));
            else
                removedSb.Append("<span class=\"word-removed\">").Append(Encode(wordsA[i])).Append("</span>");
        }

        var addedSb = new StringBuilder();
        for (int i = 0; i < wordsB.Length; i++)
        {
            if (matchB[i])
                addedSb.Append(Encode(wordsB[i]));
            else
                addedSb.Append("<span class=\"word-added\">").Append(Encode(wordsB[i])).Append("</span>");
        }

        return (removedSb.ToString(), addedSb.ToString());
    }

    private static string[] TokenizeWords(string line)
    {
        // Split into words and whitespace tokens to preserve spacing
        var tokens = new List<string>();
        var current = new StringBuilder();
        bool inSpace = false;

        foreach (char c in line)
        {
            bool isSpace = c == ' ' || c == '\t';
            if (tokens.Count == 0 && current.Length == 0)
            {
                inSpace = isSpace;
                current.Append(c);
            }
            else if (isSpace == inSpace)
            {
                current.Append(c);
            }
            else
            {
                tokens.Add(current.ToString());
                current.Clear();
                current.Append(c);
                inSpace = isSpace;
            }
        }
        if (current.Length > 0) tokens.Add(current.ToString());
        return tokens.ToArray();
    }

    private static List<RawDiffLine> ComputeLineDiff(string[] a, string[] b)
    {
        int n = a.Length;
        int m = b.Length;

        int[,] dp = new int[n + 1, m + 1];
        for (int i = 1; i <= n; i++)
            for (int j = 1; j <= m; j++)
                dp[i, j] = a[i - 1].TrimEnd('\r') == b[j - 1].TrimEnd('\r')
                    ? dp[i - 1, j - 1] + 1
                    : Math.Max(dp[i - 1, j], dp[i, j - 1]);

        var stack = new Stack<RawDiffLine>();
        int ii = n, jj = m;
        while (ii > 0 || jj > 0)
        {
            if (ii > 0 && jj > 0 && a[ii - 1].TrimEnd('\r') == b[jj - 1].TrimEnd('\r'))
            {
                stack.Push(new RawDiffLine { Text = a[ii - 1].TrimEnd('\r'), Type = DiffType.Unchanged });
                ii--; jj--;
            }
            else if (jj > 0 && (ii == 0 || dp[ii, jj - 1] >= dp[ii - 1, jj]))
            {
                stack.Push(new RawDiffLine { Text = b[jj - 1].TrimEnd('\r'), Type = DiffType.Added });
                jj--;
            }
            else
            {
                stack.Push(new RawDiffLine { Text = a[ii - 1].TrimEnd('\r'), Type = DiffType.Removed });
                ii--;
            }
        }

        var result = new List<RawDiffLine>();
        while (stack.Count > 0)
            result.Add(stack.Pop());
        return result;
    }

    private static string Encode(string text)
    {
        return System.Net.WebUtility.HtmlEncode(text);
    }
}
