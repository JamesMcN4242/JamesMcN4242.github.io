                <a href="https://www.linkedin.com/in/james-mcneil-wien" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                    Message on LinkedIn &rarr;
                </a>
            </div>

            <div class="contact-card">
                <div class="contact-icon">
                    <span class="link-icon">&#9993;</span>
                </div>
                <h2>Email</h2>
                <p>Send me an email directly. Click below to open your default email client with a pre-filled draft.</p>
                <a href="mailto:jamesmcneil42+portfolio@hotmail.co.uk?subject=Enquiry" class="btn btn-outline">
                    Send Email &rarr;
                </a>
            </div>
        </div>
