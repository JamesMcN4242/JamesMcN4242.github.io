                        <span class="tech-tag">Azure</span>
                        <span class="tech-tag">Building with AI</span>
                        <span class="tech-tag">Bicep</span>
                        <span class="tech-tag">Mobile Apps</span>
                        <span class="tech-tag">SDK Integration</span>
