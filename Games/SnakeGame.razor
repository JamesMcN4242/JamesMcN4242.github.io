@implements IDisposable

@if (!gameStarted)
{
    <div class="game-start-screen">
        <div class="game-title-icon">🐍</div>
        <h2>Snake</h2>
        <p>Use arrow keys or WASD to move. Eat food to grow and score points. Don't hit the walls or yourself!</p>
        <button class="btn btn-primary" @onclick="StartGame">Start Game</button>
    </div>
}
else if (gameOver)
{
    <div class="game-start-screen">
        <div class="game-title-icon">💀</div>
        <h2>Game Over!</h2>
        <p>You scored <strong>@score</strong> points with a snake of length <strong>@snake.Count</strong>!</p>
        <button class="btn btn-primary" @onclick="StartGame">Play Again</button>
    </div>
}
else
{
    <div class="game-hud">
        <div class="hud-item">
            <span class="hud-label">Score</span>
            <span class="hud-value">@score</span>
        </div>
        <div class="hud-item">
            <span class="hud-label">Length</span>
            <span class="hud-value">@snake.Count</span>
        </div>
    </div>

    <div class="snake-field" @ref="snakeFieldRef" tabindex="0" @onkeydown="HandleKeyDown" @onkeydown:preventDefault>
        @for (int r = 0; r < GridSize; r++)
        {
            var row = r;
            @for (int c = 0; c < GridSize; c++)
            {
                var col = c;
                var cellClass = grid[row, col];
                <div class="snake-cell @cellClass">
                    @if (cellClass == "snake-head")
                    {
                        <span>🟢</span>
                    }
                    else if (cellClass == "snake-food")
                    {
                        <span>🍎</span>
                    }
                </div>
            }
        }
    </div>

    <div class="mobile-controls">
        <div class="controls-row">
            <button class="control-btn" @onclick='() => SetDirection(-1, 0)'>▲</button>
        </div>
        <div class="controls-row">
            <button class="control-btn" @onclick='() => SetDirection(0, -1)'>◀</button>
            <button class="control-btn" @onclick='() => SetDirection(1, 0)'>▼</button>
            <button class="control-btn" @onclick='() => SetDirection(0, 1)'>▶</button>
        </div>
    </div>
}

@code {
    private const int GridSize = 20;

    private ElementReference snakeFieldRef;
    private List<(int Row, int Col)> snake = new();
    private string[,] grid = new string[GridSize, GridSize];
    private int dirRow;
    private int dirCol = 1;
    private int nextDirRow;
    private int nextDirCol = 1;
    private int foodRow;
    private int foodCol;
    private int score;
    private bool gameStarted;
    private bool gameOver;
    private System.Threading.Timer? gameTimer;
    private Random rng = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (gameStarted && !gameOver)
        {
            try { await snakeFieldRef.FocusAsync(); } catch { }
        }
    }

    private void BuildGrid()
    {
        Array.Clear(grid);

        for (int i = snake.Count - 1; i >= 1; i--)
        {
            grid[snake[i].Row, snake[i].Col] = "snake-body";
        }

        if (snake.Count > 0)
            grid[snake[0].Row, snake[0].Col] = "snake-head";

        grid[foodRow, foodCol] = "snake-food";
    }

    private void StartGame()
    {
        snake.Clear();
        int startRow = GridSize / 2;
        int startCol = GridSize / 2;
        snake.Add((startRow, startCol));
        snake.Add((startRow, startCol - 1));
        snake.Add((startRow, startCol - 2));

        dirRow = 0;
        dirCol = 1;
        nextDirRow = 0;
        nextDirCol = 1;
        score = 0;
        gameStarted = true;
        gameOver = false;

        SpawnFood();
        BuildGrid();
        gameTimer = new System.Threading.Timer(GameLoop, null, 200, 150);
    }

    private void SpawnFood()
    {
        var emptyCells = new List<(int, int)>();
        for (int r = 0; r < GridSize; r++)
        {
            for (int c = 0; c < GridSize; c++)
            {
                if (!snake.Any(s => s.Row == r && s.Col == c))
                    emptyCells.Add((r, c));
            }
        }

        if (emptyCells.Count > 0)
        {
            var pick = emptyCells[rng.Next(emptyCells.Count)];
            foodRow = pick.Item1;
            foodCol = pick.Item2;
        }
    }

    private void GameLoop(object? state)
    {
        if (gameOver) return;

        dirRow = nextDirRow;
        dirCol = nextDirCol;

        var head = snake[0];
        int newRow = head.Row + dirRow;
        int newCol = head.Col + dirCol;

        // Wall collision
        if (newRow < 0 || newRow >= GridSize || newCol < 0 || newCol >= GridSize)
        {
            EndGame();
            return;
        }

        // Self collision (skip tail since it will move unless eating)
        bool eating = newRow == foodRow && newCol == foodCol;
        for (int i = 0; i < (eating ? snake.Count : snake.Count - 1); i++)
        {
            if (snake[i].Row == newRow && snake[i].Col == newCol)
            {
                EndGame();
                return;
            }
        }

        snake.Insert(0, (newRow, newCol));

        if (eating)
        {
            score += 10;
            SpawnFood();
        }
        else
        {
            snake.RemoveAt(snake.Count - 1);
        }

        BuildGrid();
        InvokeAsync(StateHasChanged);
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowUp" or "w" or "W":
                SetDirection(-1, 0);
                break;
            case "ArrowDown" or "s" or "S":
                SetDirection(1, 0);
                break;
            case "ArrowLeft" or "a" or "A":
                SetDirection(0, -1);
                break;
            case "ArrowRight" or "d" or "D":
                SetDirection(0, 1);
                break;
        }
    }

    private void SetDirection(int dRow, int dCol)
    {
        // Don't allow reversing direction
        if (dRow == -dirRow && dCol == -dirCol) return;
        nextDirRow = dRow;
        nextDirCol = dCol;
    }

    private void EndGame()
    {
        gameOver = true;
        gameTimer?.Dispose();
        gameTimer = null;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        gameTimer?.Dispose();
    }
}
