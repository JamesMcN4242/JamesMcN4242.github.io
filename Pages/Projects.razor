@page "/projects"
@page "/projects/{ProjectId}"
@inject ProjectService ProjectService
@inject NavigationManager Navigation

@if (!string.IsNullOrEmpty(ProjectId))
{
    var project = ProjectService.GetProjectById(ProjectId);
    if (project != null)
    {
        <PageTitle>@project.Title - James McNeil</PageTitle>

        <section class="project-detail">
            <div class="section-container">
                <a href="projects" class="back-link">&larr; Back to Projects</a>

                <div class="detail-header">
                    <div class="detail-meta">
                        <span class="detail-category">@project.Category</span>
                        <span class="detail-date">@project.Date.ToString("MMMM yyyy")</span>
                    </div>
                    <h1>@project.Title</h1>
                </div>

                <div class="detail-body">
                    <div class="detail-content">
                        @foreach (var paragraph in project.Description.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <p>@paragraph</p>
                        }
                    </div>

                    <aside class="detail-sidebar">
                        <div class="sidebar-section">
                            <h3>Technologies</h3>
                            <div class="tech-list">
                                @foreach (var tech in project.Technologies)
                                {
                                    <span class="tech-tag">@tech</span>
                                }
                            </div>
                        </div>

                        @if (project.Links.Where(l => !l.Url.StartsWith("/")).Any())
                        {
                            <div class="sidebar-section">
                                <h3>Links</h3>
                                <div class="link-list">
                                    @foreach (var link in project.Links.Where(l => !l.Url.StartsWith("/")))
                                    {
                                        <a href="@link.Url" target="_blank" rel="noopener noreferrer" class="project-link">
                                            @link.Label &nearr;
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </aside>
                </div>

                @if (project.Id == "play")
                {
                    <PortfolioSite.Pages.Play Embedded="true" />
                }
                else if (project.Id == "particle-universe")
                {
                    <PortfolioSite.Pages.FunExperiments Embedded="true" />
                }
                else if (project.Id == "shaderlab")
                {
                    <PortfolioSite.Pages.ShaderLabExp Embedded="true" />
                }
                else if (project.Id == "text-compare")
                {
                    <PortfolioSite.Pages.TextCompare Embedded="true" />
                }
            </div>
        </section>
    }
    else
    {
        <PageTitle>Project Not Found - James McNeil</PageTitle>
        <div class="not-found">
            <h1>Project Not Found</h1>
            <p>The project you're looking for doesn't exist.</p>
            <a href="projects" class="btn btn-primary">Back to Projects</a>
        </div>
    }
}
else
{
    <PageTitle>Projects - James McNeil</PageTitle>

    <section class="projects-page">
        <div class="section-container">
            <div class="section-header">
                <h1>Projects</h1>
                <p>A collection of professional, personal, and game jam projects</p>
            </div>

            <div class="filter-bar">
                <button class="filter-btn @(selectedCategory == null ? "active" : "")"
                        @onclick="() => SetCategory(null)">
                    All
                </button>
                @foreach (var category in ProjectService.GetCategories())
                {
                    <button class="filter-btn @(selectedCategory == category ? "active" : "")"
                            @onclick="() => SetCategory(category)">
                        @category
                    </button>
                }
            </div>

            <div class="project-grid">
                @foreach (var project in filteredProjects)
                {
                    <a href="projects/@project.Id" class="project-card">
                        <div class="card-category">@project.Category</div>
                        <h3 class="card-title">@project.Title</h3>
                        <p class="card-summary">@project.Summary</p>
                        <div class="card-tech">
                            @foreach (var tech in project.Technologies.Take(3))
                            {
                                <span class="tech-tag">@tech</span>
                            }
                        </div>
                        <div class="card-footer">
                            <span class="card-date">@project.Date.ToString("MMM yyyy")</span>
                            @if (project.IsFeatured)
                            {
                                <span class="featured-badge">Featured</span>
                            }
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>
}

@code {
    [Parameter]
    public string? ProjectId { get; set; }

    [SupplyParameterFromQuery(Name = "category")]
    public string? InitialCategory { get; set; }

    private string? selectedCategory;
    private IReadOnlyList<Project> filteredProjects = Array.Empty<Project>();

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(ProjectId))
        {
            if (InitialCategory != null && selectedCategory == null)
            {
                selectedCategory = InitialCategory;
            }
            UpdateFilteredProjects();
        }
    }

    private void SetCategory(string? category)
    {
        selectedCategory = category;
        UpdateFilteredProjects();
    }

    private void UpdateFilteredProjects()
    {
        filteredProjects = selectedCategory == null
            ? ProjectService.GetAllProjects().OrderByDescending(p => p.Date).ToList().AsReadOnly()
            : ProjectService.GetProjectsByCategory(selectedCategory);
    }
}
