@page "/projects"
@page "/projects/{ProjectId}"
@inject ProjectService ProjectService
@inject NavigationManager Navigation

@if (!string.IsNullOrEmpty(ProjectId))
{
    var project = ProjectService.GetProjectById(ProjectId);
    if (project != null)
    {
        <PageTitle>@project.Title - Sourabh Chauhan</PageTitle>

        <section class="project-detail">
            <div class="section-container">
                <a href="projects" class="back-link">&larr; Back to Projects</a>

                <div class="detail-header">
                    <div class="detail-image">
                        <img src="@project.ImageUrl" alt="@project.Title" />
                    </div>
                    <div class="detail-info">
                        <div class="detail-meta">
                            <span class="detail-year">@project.Year</span>
                            @foreach (var tag in project.Tags)
                            {
                                <a href="projects?tags=@tag" class="tech-tag clickable">@tag</a>
                            }
                        </div>
                        <h1>@project.Title</h1>
                    </div>
                </div>

                <div class="detail-body">
                    <div class="detail-content">
                        @foreach (var paragraph in project.Description.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <p>@paragraph</p>
                        }
                    </div>

                    @if (project.Links.Any())
                    {
                        <aside class="detail-sidebar">
                            <div class="sidebar-section">
                                <h3>Links</h3>
                                <div class="link-list">
                                    @foreach (var link in project.Links)
                                    {
                                        <a href="@link.Url" target="_blank" rel="noopener noreferrer" class="project-link">
                                            @link.Label &nearr;
                                        </a>
                                    }
                                </div>
                            </div>
                        </aside>
                    }
                </div>
            </div>
        </section>
    }
    else
    {
        <PageTitle>Project Not Found</PageTitle>
        <div class="not-found">
            <h1>Project Not Found</h1>
            <p>The project you're looking for doesn't exist.</p>
            <a href="projects" class="btn btn-primary">Back to Projects</a>
        </div>
    }
}
else
{
    <PageTitle>Projects - Sourabh Chauhan</PageTitle>

    <section class="projects-page">
        <div class="section-container">
            <div class="section-header">
                <h1>Projects</h1>
                <p>A collection of data engineering, ML, and research projects</p>
            </div>

            <div class="filter-bar">
                <button class="filter-btn @(selectedTag == null ? "active" : "")"
                        @onclick="() => SetTag(null)">
                    All
                </button>
                @foreach (var tag in ProjectService.GetAllTags())
                {
                    <button class="filter-btn @(selectedTag == tag ? "active" : "")"
                            @onclick="() => SetTag(tag)">
                        @tag
                    </button>
                }
            </div>

            <div class="project-grid">
                @foreach (var project in filteredProjects)
                {
                    <a href="projects/@project.Id" class="project-card">
                        <div class="card-image">
                            <img src="@project.ImageUrl" alt="@project.Title" loading="lazy" />
                        </div>
                        <div class="card-body">
                            <div class="card-tags">
                                @foreach (var tag in project.Tags)
                                {
                                    <span class="tech-tag">@tag</span>
                                }
                            </div>
                            <h3 class="card-title">@project.Title</h3>
                            <p class="card-summary">@project.Summary</p>
                            <div class="card-footer">
                                <span class="card-year">@project.Year</span>
                                <span class="read-more">Read More &rarr;</span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>
}

@code {
    [Parameter]
    public string? ProjectId { get; set; }

    [SupplyParameterFromQuery(Name = "tags")]
    public string? InitialTag { get; set; }

    private string? selectedTag;
    private IReadOnlyList<Project> filteredProjects = Array.Empty<Project>();

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(ProjectId))
        {
            if (InitialTag != null && selectedTag == null)
            {
                selectedTag = InitialTag;
            }
            UpdateFilteredProjects();
        }
    }

    private void SetTag(string? tag)
    {
        selectedTag = tag;
        UpdateFilteredProjects();
    }

    private void UpdateFilteredProjects()
    {
        filteredProjects = selectedTag == null
            ? ProjectService.GetAllProjects()
            : ProjectService.GetProjectsByTag(selectedTag);
    }
}
