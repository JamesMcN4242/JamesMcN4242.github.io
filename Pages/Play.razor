@page "/play"

@if (!Embedded)
{
    <PageTitle>Play - James McNeil</PageTitle>
}

<section class="play-page @(Embedded ? "embedded" : "")">
    <div class="@(Embedded ? "" : "section-container")">
        @if (!Embedded)
        {
            <div class="section-header">
                <h1>Play / AI Experiment</h1>
                <p>Here I wanted to see if I could get AI to generate some simple games in Blazor that could be hosted via Github Pages without issue.</p>
            </div>
        }

        <div class="game-tabs">
            <button class="game-tab @(activeTab == 0 ? "active" : "")" @onclick="() => SwitchTab(0)">🎮 Creature Catcher</button>
            <button class="game-tab @(activeTab == 1 ? "active" : "")" @onclick="() => SwitchTab(1)">🐦 Flappy Bird</button>
            <button class="game-tab @(activeTab == 2 ? "active" : "")" @onclick="() => SwitchTab(2)">🐍 Snake</button>
        </div>

        <div class="game-tab-content">
            @switch (activeTab)
            {
                case 0:
                    <CreatureCatcher @key="tabKey" />
                    break;
                case 1:
                    <FlappyBird @key="tabKey" />
                    break;
                case 2:
                    <SnakeGame @key="tabKey" />
                    break;
            }
        </div>
    </div>
</section>

@code {
    [Parameter] public bool Embedded { get; set; }

    private int activeTab = 0;
    private int tabKey = 0;

    private void SwitchTab(int tab)
    {
        activeTab = tab;
        tabKey++;
    }
}
