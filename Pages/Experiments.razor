@page "/experiments"

<PageTitle>Experiments - James McNeil</PageTitle>

<section class="experiments-list-page">
    <div class="section-container">
        <div class="section-header">
            <h1>Random Experiments</h1>
            <p>A collection of fun tech demos and utilities I've built with or without AI for fun and to test the limits of Blazor.</p>
        </div>

        <div class="experiment-cards">
            <a href="particle-universe" class="experiment-card">
                <div class="experiment-card-icon">🌌</div>
                <h3>Particle Universe</h3>
                <p>Interactive particle physics demo. Click to spawn colorful particles with gravity, trails, and bouncing.</p>
                <div class="experiment-card-tags">
                    <span class="tech-tag">Physics</span>
                    <span class="tech-tag">Interactive</span>
                </div>
            </a>

            <a href="shaderLabExp" class="experiment-card">
                <div class="experiment-card-icon">🎨</div>
                <h3>ShaderLab</h3>
                <p>Write math expressions to generate animated pixel art. Features a custom expression parser with built-in presets.</p>
                <div class="experiment-card-tags">
                    <span class="tech-tag">Math</span>
                    <span class="tech-tag">Visual</span>
                    <span class="tech-tag">Parsing</span>
                </div>
            </a>

            <a href="text-compare" class="experiment-card">
                <div class="experiment-card-icon">📝</div>
                <h3>Text Compare</h3>
                <p>Compare two pieces of text side-by-side and see the differences highlighted — additions, removals, and changes.</p>
                <div class="experiment-card-tags">
                    <span class="tech-tag">Utility</span>
                    <span class="tech-tag">Diff</span>
                </div>
            </a>
        </div>
    </div>
</section>
